// =============================================================================
// Power BI measures - generated by scripts/build_powerbi_project.py (do not edit by hand).
// They live in the _Measures table of powerbi/pbip/delivery_reviews.SemanticModel.
// Flags in the model are 1/0 integers exported from SQLite; blank = not applicable.
// `== 0` (strict) is used so BLANK is never treated as 0 / FALSE.
// =============================================================================

// ---------- [1 Volume] ----------
// All orders placed, every status. Grain: order.  (format: #,0)
Total Orders =
    COUNTROWS ( fct_orders )

// Delivery-KPI population: status delivered AND a delivery timestamp (denominator of the late rate).  (format: #,0)
Delivered Orders =
    CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_delivery_kpi_eligible] = 1 )

// Total Orders restricted to the complete months Jan-2017..Aug-2018 (used by monthly charts).  (format: #,0)
Orders (Trend Window) =
    CALCULATE ( [Total Orders], dim_date[in_trend_window] = 1 )


// ---------- [2 Delivery] ----------
// Delivered on a later calendar date than the estimated delivery date.  (format: #,0)
Late Orders =
    CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_late] = 1 )

// Delivered on or before the estimated date. Strict == so blank (not in KPI) is not counted as 0.  (format: #,0)
On-Time Orders =
    CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_late] == 0 )

// Late Orders / Delivered Orders. Order grain.  (format: 0.0%)
Late Rate % =
    DIVIDE ( [Late Orders], [Delivered Orders] )

// Sensitivity: delivery timestamp > estimated timestamp (midnight), so same-day deliveries count as late.  (format: 0.0%)
Late Rate % (Timestamp Rule) =
    DIVIDE ( CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_late_timestamp_rule] = 1 ), [Delivered Orders] )

// Late Rate % restricted to the complete months Jan-2017..Aug-2018.  (format: 0.0%)
Late Rate % (Trend Window) =
    CALCULATE ( [Late Rate %], dim_date[in_trend_window] = 1 )

// Late rate for the same period ignoring customer, seller, product and lane filters.  (format: 0.0%)
Marketplace Late Rate % =
    CALCULATE ( [Late Rate %], REMOVEFILTERS ( dim_customer ), REMOVEFILTERS ( dim_seller ), REMOVEFILTERS ( dim_product ), REMOVEFILTERS ( fct_order_items ) )

// Late orders above what the group would have at the marketplace rate (rate x volume).  (format: #,0)
Excess Late Orders =
    [Late Orders] - [Delivered Orders] * [Marketplace Late Rate %]

// Share of delivered orders handed to the carrier after the seller shipping deadline.  (format: 0.0%)
Carrier Handoff Late % =
    DIVIDE ( CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_carrier_handoff_late] = 1 ), CALCULATE ( COUNTROWS ( fct_orders ), NOT ISBLANK ( fct_orders[is_carrier_handoff_late] ) ) )


// ---------- [3 Lifecycle] ----------
// Median hours from purchase to payment approval (delivered orders, valid sequence).  (format: 0.0)
Median Hours Purchase to Approval =
    MEDIAN ( fct_orders[hours_purchase_to_approval] )

// Median days from approval to carrier hand-off (delivered orders, valid sequence).  (format: 0.0)
Median Days Approval to Carrier =
    MEDIAN ( fct_orders[days_approval_to_carrier] )

// Median days in carrier transit (delivered orders, valid sequence).  (format: 0.0)
Median Days Carrier to Customer =
    MEDIAN ( fct_orders[days_carrier_to_customer] )

// Median approval -> carrier days over orders whose three stage timestamps are all present and in order.  (format: 0.0)
Median Days Approval to Carrier (Valid Lifecycle) =
    CALCULATE ( MEDIAN ( fct_orders[days_approval_to_carrier] ), fct_orders[is_lifecycle_valid] = 1 )

// Median carrier -> customer days over orders whose three stage timestamps are all present and in order.  (format: 0.0)
Median Days Carrier to Customer (Valid Lifecycle) =
    CALCULATE ( MEDIAN ( fct_orders[days_carrier_to_customer] ), fct_orders[is_lifecycle_valid] = 1 )

// Median days from purchase to delivery (delivery-KPI orders).  (format: 0.0)
Median Days Purchase to Delivery =
    MEDIAN ( fct_orders[days_purchase_to_delivery] )


// ---------- [4 Reviews] ----------
// Orders with a review (one review per order).  (format: #,0)
Reviewed Orders =
    COUNT ( fct_orders[review_score] )

// Average 1-5 score over reviewed orders in the current filter (all statuses).  (format: 0.00)
Avg Review Score =
    AVERAGE ( fct_orders[review_score] )

// Average score of reviewed delivery-KPI orders.  (format: 0.00)
Avg Review Score (Delivered) =
    CALCULATE ( [Avg Review Score], fct_orders[is_delivery_kpi_eligible] = 1 )

// Average score of reviewed on-time orders.  (format: 0.00)
Avg Review Score (On Time) =
    CALCULATE ( [Avg Review Score], fct_orders[is_late] == 0 )

// Average score of reviewed late orders.  (format: 0.00)
Avg Review Score (Late) =
    CALCULATE ( [Avg Review Score], fct_orders[is_late] = 1 )

// Association only - not proof that delay causes the lower score.  (format: 0.00)
Review Gap (Late - On Time) =
    [Avg Review Score (Late)] - [Avg Review Score (On Time)]

// Share of reviewed orders with 1 or 2 stars.  (format: 0.0%)
Low Review Share % =
    DIVIDE ( CALCULATE ( [Reviewed Orders], fct_orders[review_score] <= 2 ), [Reviewed Orders] )

// Review-timing caveat: share of late-order reviews created before the parcel arrived.  (format: 0.0%)
Late Reviews Written Before Delivery % =
    DIVIDE ( CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_late] = 1, fct_orders[review_created_before_delivery] = 1 ), CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_late] = 1, fct_orders[has_review] = 1 ) )

// Average score of late orders whose review was written after delivery.  (format: 0.00)
Avg Review Score (Late, Written After Delivery) =
    CALCULATE ( [Avg Review Score], fct_orders[is_late] = 1, fct_orders[review_created_before_delivery] == 0 )


// ---------- [5 Status] ----------
// Status canceled.  (format: #,0)
Canceled Orders =
    CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[order_status] = "canceled" )

// Status unavailable.  (format: #,0)
Unavailable Orders =
    CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[order_status] = "unavailable" )

// (Canceled + unavailable) / all orders.  (format: 0.00%)
Canceled or Unavailable % =
    DIVIDE ( [Canceled Orders] + [Unavailable Orders], [Total Orders] )

// Canceled or Unavailable % restricted to complete months.  (format: 0.00%)
Canceled or Unavailable % (Trend Window) =
    CALCULATE ( [Canceled or Unavailable %], dim_date[in_trend_window] = 1 )


// ---------- [6 Value] ----------
// Item price + freight of delivered orders, BRL. Gross merchandise value - NOT profit or Olist revenue.  (format: R$ #,0)
Delivered Order Value (BRL) =
    CALCULATE ( SUM ( fct_orders[order_value_brl] ), fct_orders[status_group] = "delivered" )

// Item price + freight at item grain - use under category/seller filters.  (format: R$ #,0)
Item Value (BRL) =
    SUM ( fct_order_items[item_value_brl] )

// Delivered order value / delivered orders.  (format: R$ #,0.00)
Avg Delivered Order Value (BRL) =
    DIVIDE ( [Delivered Order Value (BRL)], CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[status_group] = "delivered" ) )

// Sum of payment records, BRL (can include instalment interest and vouchers).  (format: R$ #,0)
Payments (BRL) =
    SUM ( fct_payments[payment_value_brl] )
