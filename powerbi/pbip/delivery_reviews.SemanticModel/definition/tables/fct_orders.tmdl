/// Main fact. Grain: one row per order (99,441). Flags are 1/0; blank = not applicable.
table fct_orders
	lineageTag: 37e9887e-40b5-5a77-8f9d-8760a36a90a5

	/// Late / On time for delivery-KPI orders; other orders are 'Not in delivery KPI'.
	column 'Delivery Outcome' = SWITCH ( TRUE (), ISBLANK ( fct_orders[is_late] ), "Not in delivery KPI", fct_orders[is_late] = 1, "Late", "On time" )
		dataType: string
		summarizeBy: none
		lineageTag: 3fd55a82-6924-5fb5-b238-97110334e19a

	/// Review score as a category label (1-5).
	column 'Review Stars' = IF ( ISBLANK ( fct_orders[review_score] ), BLANK (), FORMAT ( fct_orders[review_score], "0" ) & " star" )
		dataType: string
		summarizeBy: none
		lineageTag: 758cd885-a28f-5f14-8491-2bfb07b87c73

