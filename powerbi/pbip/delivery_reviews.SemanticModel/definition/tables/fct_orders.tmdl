	partition fct_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fct_orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // SQLite NULLs are exported as empty cells: turn them into real nulls before typing
				    EmptyToNull = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"order_id", type text}, {"customer_id", type text}, {"customer_unique_id", type text}, {"customer_state", type text}, {"customer_region", type text}, {"order_status", type text}, {"status_group", type text}, {"order_purchase_timestamp", type datetime}, {"order_approved_at", type datetime}, {"order_delivered_carrier_date", type datetime}, {"order_delivered_customer_date", type datetime}, {"order_estimated_delivery_date", type datetime}, {"purchase_date", type date}, {"purchase_month", type date}, {"in_trend_window", Int64.Type}, {"item_count", Int64.Type}, {"seller_count", Int64.Type}, {"category_count", Int64.Type}, {"has_items", Int64.Type}, {"items_price_brl", type number}, {"freight_brl", type number}, {"order_value_brl", type number}, {"latest_shipping_limit_date", type datetime}, {"payment_count", Int64.Type}, {"payment_value_brl", type number}, {"main_payment_type", type text}, {"max_installments", Int64.Type}, {"used_voucher", Int64.Type}, {"delivery_kpi_status", type text}, {"is_delivery_kpi_eligible", Int64.Type}, {"is_late", Int64.Type}, {"is_late_timestamp_rule", Int64.Type}, {"days_vs_estimate", Int64.Type}, {"days_purchase_to_delivery", type number}, {"days_purchase_to_estimate", type number}, {"hours_purchase_to_approval", type number}, {"days_approval_to_carrier", type number}, {"days_carrier_to_customer", type number}, {"is_lifecycle_valid", Int64.Type}, {"is_carrier_handoff_late", Int64.Type}, {"review_score", Int64.Type}, {"review_count", Int64.Type}, {"has_review", Int64.Type}, {"review_has_comment", Int64.Type}, {"review_creation_date", type datetime}, {"review_created_before_delivery", Int64.Type}}, "en-US")
				in
				    Typed
