/// Grain: one row per order item (112,650). Count orders with the order-level measures, not rows.
table fct_order_items
	lineageTag: 493d6c80-383c-52ae-9549-aeff0729be7f

	/// Shipping lane: seller state -> customer state.
	column Lane = RELATED ( dim_seller[seller_state] ) & " -> " & RELATED ( fct_orders[customer_state] )
		dataType: string
		summarizeBy: none
		lineageTag: fceeda7e-233a-5865-b268-7f5ad9433cca

	column order_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: order_id
		lineageTag: 999b0ea4-e73d-5198-ab32-c465162513df

	column order_item_id
		dataType: int64
		summarizeBy: none
		sourceColumn: order_item_id
		lineageTag: f0bc4f0e-a6cd-50ff-ae5e-be7313d64db2

	column product_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_id
		lineageTag: da1be302-45e4-5dcf-8179-785fd82e320c

	column seller_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: seller_id
		lineageTag: 921cd15d-8ac3-560c-9cce-3d25ba24f495

	column customer_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_id
		lineageTag: ed1cfdac-3956-571c-bc68-a5058d338f6e

	column purchase_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: purchase_date
		lineageTag: a398eac4-12a8-5ac5-9817-677afa7145e0

	column shipping_limit_date
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		summarizeBy: none
		sourceColumn: shipping_limit_date
		lineageTag: 5886db6e-ca45-5897-bd09-fb311efa3320

	column price_brl
		dataType: double
		summarizeBy: none
		sourceColumn: price_brl
		lineageTag: 7fc5a050-eb50-558c-87c4-1c796d183da6

	column freight_brl
		dataType: double
		summarizeBy: none
		sourceColumn: freight_brl
		lineageTag: 7ce8fa3d-a65c-532e-88b1-a662b65fad01

	column item_value_brl
		dataType: double
		summarizeBy: none
		sourceColumn: item_value_brl
		lineageTag: c022c2ba-7ae0-516c-ab91-da7d95d2bc3f

	partition fct_order_items = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fct_order_items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // SQLite NULLs are exported as empty cells: turn them into real nulls before typing
				    EmptyToNull = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"order_id", type text}, {"order_item_id", Int64.Type}, {"product_id", type text}, {"seller_id", type text}, {"customer_id", type text}, {"purchase_date", type date}, {"shipping_limit_date", type datetime}, {"price_brl", type number}, {"freight_brl", type number}, {"item_value_brl", type number}}, "en-US")
				in
				    Typed
